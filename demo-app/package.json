{
  "name": "order-api",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn src/server.ts",
    "seed": "ts-node src/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage",
    "knip": "knip",
    "structure": "bash ../scripts/check-structure.sh",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run knip && npm audit --omit=dev && npm run structure",
    "fuzz": "npm run build && vitest run --config vitest.fuzz.config.mts",
    "fuzz:nightly": "npm run build && FUZZ_RUNS=2000 FUZZ_SEED=$(date +%s) vitest run --config vitest.fuzz.config.mts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.0.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.15.0",
    "eslint-plugin-security": "^4.2.1",
    "fast-check": "^4.11.0",
    "jscpd": "^5.4.3",
    "knip": "^6.48.0",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12"
  }
}
